{
  "name": "mine-in-the-middle",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @mitm/server --filter @mitm/admin dev",
    "build": "pnpm --filter @mitm/shared build && pnpm --filter @mitm/admin build && pnpm --filter @mitm/server build",
    "start:prod": "pnpm --filter @mitm/server start:prod",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:load": "pnpm --filter @mitm/server test:load",
    "db:generate": "pnpm --filter @mitm/server db:generate",
    "db:migrate": "pnpm --filter @mitm/server db:migrate",
    "db:deploy": "pnpm --filter @mitm/server db:deploy",
    "db:validate": "pnpm --filter @mitm/server exec prisma validate",
    "bootstrap:admin": "pnpm --filter @mitm/server bootstrap:admin",
    "compose:core": "docker compose --profile core up -d",
    "compose:all": "docker compose --profile core --profile bitcoin --profile monero --profile observability up -d",
    "compose:down": "docker compose --profile core --profile bitcoin --profile monero --profile observability down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts@7.1.5": "8.0.0",
      "fast-uri@3.1.5": "3.1.6",
      "fast-uri@4.1.2": "4.1.3",
      "fastify@5.10.0": "5.12.1",
      "find-my-way": "9.7.0",
      "js-yaml": "5.2.2",
      "mysql2@3.15.3": "3.23.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
