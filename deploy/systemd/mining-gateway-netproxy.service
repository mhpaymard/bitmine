[Unit]
Description=Mining Gateway system-wide proxy/VPN failover agent
After=network-online.target mining-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=NETPROXY_STATE_DIR=/opt/mining-gateway/.local/netproxy
ExecStart=/usr/bin/env bash /opt/mining-gateway/scripts/netproxy-agent.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
ReadWritePaths=/opt/mining-gateway/.local/netproxy /etc/wireguard /run /var/log

[Install]
WantedBy=multi-user.target
