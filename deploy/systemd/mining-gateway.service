[Unit]
Description=Bitcoin and Monero Mining Gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=mining-gateway
Group=mining-gateway
WorkingDirectory=/opt/mining-gateway
Environment=NODE_ENV=production
Environment=SERVE_ADMIN_STATIC=true
EnvironmentFile=/opt/mining-gateway/.env
ExecStartPre=/usr/bin/pnpm db:deploy
ExecStart=/usr/bin/pnpm start:prod
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mining-gateway
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
