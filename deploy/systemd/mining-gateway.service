[Unit]
Description=Bitcoin and Monero Mining Gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=mining-gateway
Group=mining-gateway
WorkingDirectory=/opt/mining-gateway
EnvironmentFile=/opt/mining-gateway/.env
Environment=NODE_ENV=production
Environment=SERVE_ADMIN_STATIC=true
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/env pnpm db:deploy
ExecStart=/usr/bin/env pnpm start:prod
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
ReadWritePaths=/opt/mining-gateway/.local
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
