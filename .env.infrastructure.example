GATEWAY_DOMAIN=gateway.local
ADMIN_UPSTREAM=host.docker.internal:3000
ADMIN_ALLOWLIST=192.168.0.0/16
ADMIN_BIND_IP=0.0.0.0
ADMIN_HTTP_PORT=8080
ADMIN_HTTPS_PORT=8443
POSTGRES_HOST_PORT=5432
BITCOIN_CHAIN=regtest
BITCOIN_RPC_PORT=18443
BITCOIN_PRUNE_MIB=100000
MONERO_NETWORK=stagenet
# Set true only once to create a new stagenet wallet. Secure the generated seed immediately.
MONERO_BOOTSTRAP_WALLET=false
# Required by the backup profile: age1...
BACKUP_AGE_RECIPIENT=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
