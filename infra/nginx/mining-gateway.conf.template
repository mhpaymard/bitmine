limit_req_zone $binary_remote_addr zone=portal_api:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
	default upgrade;
	'' '';
}

upstream mining_gateway_app {
	server 127.0.0.1:3000;
	keepalive 32;
}

server {
	listen __WEB_BIND_IP__:80;
	server_name __CERT_DOMAINS__;

	location ^~ /.well-known/acme-challenge/ {
		root /var/www/certbot;
		default_type text/plain;
	}

	location / {
		return 301 https://__PANEL_DOMAIN__$request_uri;
	}
}

server {
	listen __WEB_BIND_IP__:443 ssl http2;
	server_name __PANEL_DOMAIN__;

	ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1d;
	ssl_session_tickets off;

	server_tokens off;
	client_max_body_size 1m;

	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header Referrer-Policy "same-origin" always;
	add_header X-Frame-Options "SAMEORIGIN" always;

	location = /portal {
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}

	location ^~ /portal/ {
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}

	location ^~ /assets/ {
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}

	location = /api/v1/public/portal/summary {
		limit_req zone=portal_api burst=5 nodelay;
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}

	location = /api/v1/public/portal/payout-destinations {
		limit_req zone=portal_api burst=3 nodelay;
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}

	location / {
		allow 127.0.0.1;
		allow ::1;
		allow __ADMIN_CIDR__;
		deny all;
		proxy_pass http://mining_gateway_app;
		include /etc/nginx/snippets/mining-gateway-proxy.conf;
	}
}
